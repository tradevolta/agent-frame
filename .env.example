# Copy to .env.local for local development. Every service is optional locally:
# without keys the app runs in mock mode (fake checkout, local storage, fake AI).

# --- Site
NEXT_PUBLIC_APP_URL=http://localhost:3000        # production: https://realagentframe.com
NEXT_PUBLIC_BRAND_NAME=AgentFrame
NEXT_PUBLIC_BRAND_DOMAIN=realagentframe.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@realagentframe.com
# Where order-failure and retry-queue alerts go (defaults to the support address above).
# ALERT_EMAIL=you@example.com
APP_SIGNING_SECRET=                               # openssl rand -base64 32  (REQUIRED in production)
ADMIN_PASSWORD=                                   # protects /admin (REQUIRED in production)
CRON_SECRET=                                      # Vercel sends this to /api/cron/* (openssl rand -hex 32)

# --- Database (set automatically by the Vercel integration)
# Supabase sets POSTGRES_URL (+ POSTGRES_URL_NON_POOLING for migrations); Neon sets DATABASE_URL.
POSTGRES_URL=
DATABASE_URL=

# --- Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                            # from the webhook endpoint → /api/webhooks/stripe
STRIPE_REFERRAL_COUPON_ID=                        # optional: coupon applied to ?ref= links (e.g. 20% off)

# --- AI (fal.ai)
FAL_KEY=
FAL_TRAINER_MODEL=fal-ai/flux-lora-portrait-trainer
FAL_TRAINING_STEPS=2000
FAL_TRAIN_COST_CENTS=250                          # used for cost estimates in /admin only
FAL_IMAGE_COST_CENTS=4

# --- Storage (Vercel Blob sets this automatically)
BLOB_READ_WRITE_TOKEN=

# --- Email: ZeptoMail API (preferred). Token from ZeptoMail → Mail Agents → SMTP/API → Send Mail token.
ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_API_URL=https://api.zeptomail.eu/v1.1/email   # only for EU/IN/AU data centers
EMAIL_FROM="AgentFrame <studio@realagentframe.com>"      # sender on your verified ZeptoMail domain

# --- Email fallback: Zoho Mail SMTP (used only if ZEPTOMAIL_TOKEN is empty)
# Custom-domain Zoho accounts: smtppro.zoho.com. Free personal accounts: smtp.zoho.com.
# EU/India data centers: smtppro.zoho.eu / smtppro.zoho.in. Port 465 (SSL) or 587 (TLS).
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=studio@realagentframe.com                   # the Zoho mailbox that sends
SMTP_PASS=                                        # a Zoho *app-specific password* (required if 2FA is on)


# Local `next start` only: allow the fake checkout without Stripe keys
# ALLOW_MOCK_PAYMENTS=true
